{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "module": "preserve",
    "target": "es2022",
    "allowJs": true,
    "jsx": "react",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": false,
    "strictPropertyInitialization": false,
    "types": [],
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "typeRoots": [ "./types", "./node_modules/@types" ]
  },
  "include": [
    "src/**/*"
  ]
}
