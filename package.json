{
  "name": "anno-2018",
  "version": "1.0.0",
  "private": true,
  "license": "AGPLv3",
  "dependencies": {
    "async-lock": "^1.4.1",
    "btoa": "^1.2.1",
    "escape-string-regexp": "^5.0.0",
    "filer.js": "0.4.5",
    "iconv-lite": "^0.6.3",
    "idb.filesystem.js": "^0.0.8",
    "jszip": "^3.10.1",
    "lamejs": "^1.2.1",
    "loglevel": "^1.9.1",
    "pixi-sound": "^3.0.4",
    "pixi-viewport": "^4.5.0",
    "pixi.js": "^5.3.12",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "rxjs": "^7.8.1",
    "smart-buffer": "^4.2.0",
    "smk2mp4": "cmfcmf/smk2mp4",
    "upng-js": "^2.1.0",
    "wavefile": "^11.0.0",
    "xml": "^1.0.1"
  },
  "devDependencies": {
    "@types/async-lock": "^1.4.2",
    "@types/jest": "^29.5.12",
    "@types/jszip": "^3.4.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^16.9.11",
    "@types/react-dom": "^16.9.3",
    "@types/xml": "^1.0.11",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.1",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "license-checker": "^25.0.1",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "3.3.3",
    "esbuild": "^0.25.0",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "http-server": "^14.1.1",
    "ts-jest": "^29.2.3",
    "ts-node": "^8.10.2",
    "typescript": "^7.0.0",
    "concurrently": "^9.1.2"
  },
  "scripts": {
    "start": "concurrently -k \"node esbuild.config.js --watch\" \"http-server dist -p 8080 -a 0.0.0.0 -c-1\"",
    "build": "node esbuild.config.js --production",
    "lint": "eslint --ext .ts,.tsx,.js,.jsx src",
    "test": "jest",
    "test-watch": "jest --notify --watchAll",
    "postinstall": "patch-package",
    "cod-converter": "ts-node --project tsconfig.node.json src/tools/cod-converter.ts",
    "bsh-converter": "ts-node --project tsconfig.node.json src/tools/bsh-converter.ts",
    "dat-converter": "ts-node --project tsconfig.node.json src/tools/dat-converter.ts",
    "gam-analyzer1": "ts-node --project tsconfig.node.json src/tools/gam-analyzer.ts",
    "gam-analyzer2": "ts-node --project tsconfig.node.json src/tools/gam-analyzer2.ts",
    "smk-converter": "ts-node --project tsconfig.node.json src/tools/smk-converter.ts",
    "wav-converter": "ts-node --project tsconfig.node.json src/tools/wav-converter.ts",
    "zei-converter": "ts-node --project tsconfig.node.json src/tools/zei-converter.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "globals": {
      "ts-jest": {
        "tsConfig": "tsconfig.node.json"
      }
    },
    "setupFiles": [
      "jest-canvas-mock"
    ],
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "browserslist": "last 2 versions, ie 10",
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  }
}
